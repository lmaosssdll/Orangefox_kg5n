# Android fstab file.
system /system ext4 ro,barrier=1 wait,logical,first_stage_mount,slotselect
system_ext /system_ext ext4 ro,barrier=1 wait,logical,first_stage_mount,slotselect
vendor /vendor ext4 ro,barrier=1 wait,logical,first_stage_mount,slotselect
product /product ext4 ro,barrier=1 wait,logical,first_stage_mount,slotselect

# DATA с расшифровкой (оставляем все флаги шифрования)
/dev/block/by-name/userdata /data f2fs noatime,nosuid,nodev,discard,inline_xattr,inline_data wait,formattable,fileencryption=aes-256-xts:aes-256-cts:v2,keydirectory=/metadata/vold/metadata_encryption
/dev/block/by-name/metadata /metadata ext4 nodev,noatime,nosuid,errors=panic wait,formattable,first_stage_mount

# USB и SD карта
/devices/platform/soc/soc:aon/64900000.usb/musb-hdrc.*.auto/usb* auto vfat defaults voldmanaged=usbdisk:auto
/devices/platform/soc/soc:ap-apb/201a0000.sdio/mmc_host/mmc1/mmc1:*/block/mmcblk1 auto vfat defaults voldmanaged=sdcard0:auto

# Системные партиции
/dev/block/by-name/prodnv /mnt/vendor/prodnv ext4 noatime,nosuid,nodev wait
/dev/block/by-name/cache /cache ext4 noatime,nosuid,nodev wait
/dev/block/by-name/socko /mnt/vendor/socko ext4 ro,noatime,nosuid,nodev wait,slotselect
/dev/block/by-name/odmko /mnt/vendor/odmko ext4 ro,noatime,nosuid,nodev wait,slotselect
/dev/block/by-name/misc /misc emmc defaults defaults
/dev/block/platform/soc/soc:ap-apb/201d0000.sdio/by-name/tranfs /tranfs ext4 rw,noatime,nosuid,nodev wait,nofail
