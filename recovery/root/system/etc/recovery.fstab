system                                   /system             ext4    ro wait,avb=vbmeta_system,logical,first_stage_mount,slotselect
system_ext                               /system_ext         ext4    ro wait,logical,first_stage_mount,slotselect
vendor                                   /vendor             ext4    ro wait,avb=vbmeta_vendor,logical,first_stage_mount,slotselect
product                                  /product            ext4    ro wait,avb=vbmeta_product,logical,first_stage_mount,slotselect

/dev/block/by-name/misc                  /misc               emmc    defaults     defaults

/dev/block/by-name/socko                 /socko              ext4    ro,noatime,nosuid,nodev,noauto_da_alloc wait,latemount,avb=socko,check,slotselect
/dev/block/by-name/odmko                 /odmko              ext4    ro,noatime,nosuid,nodev,noauto_da_alloc wait,latemount,avb=odmko,check,slotselect

/dev/block/mmcblk1p1                     /sdcard        vfat    defaults      defaults,check
# Физические разделы (Physical Partitions)
/dev/block/by-name/userdata              /data               f2fs    noatime,nosuid,nodev,discard,fsync_mode=nobarrier    wait,check,formattable,fileencryption=aes-256-xts
/dev/block/by-name/cache                 /cache              ext4    noatime,nosuid,nodev,nomblk_io_submit,errors=panic   wait,check,formattable
/dev/block/by-name/metadata              /metadata           ext4    noatime,nosuid,nodev,discard                         wait,check,formattable

# Образы и загрузочные разделы (Boot & Images)
/dev/block/by-name/boot                  /boot               emmc    defaults     defaults
/dev/block/by-name/recovery              /recovery           emmc    defaults     defaults
/dev/block/by-name/dtbo                  /dtbo               emmc    defaults     defaults
/dev/block/by-name/vbmeta                /vbmeta             emmc    defaults     defaults
/dev/block/by-name/vbmeta_system         /vbmeta_system      emmc    defaults     defaults
/dev/block/by-name/vbmeta_vendor         /vbmeta_vendor      emmc    defaults     defaults
/dev/block/by-name/logo                  /logo               emmc    defaults     defaults
/dev/block/by-name/tranfs                /tranfs             ext4    defaults     defaults
